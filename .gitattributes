# Normalise line endings for everyone, permanently.
# Both projects were authored on Windows: 19 tracked files in Hikaru and 31 in
# Magnus were CRLF, producing phantom diffs with no content change. A repo-level
# attribute fixes this for every contributor; core.autocrlf only fixes one machine.
* text=auto eol=lf

# Never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.bmp   binary
*.webp  binary
*.mp4   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.zip   binary
*.pt    binary
*.nnue  binary
*.dll   binary
*.so    binary
*.dylib binary
*.exe   binary
*.pyd   binary
*.otf   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.eot   binary
*.rdk   binary
*.fzz   binary
*.STL   binary
*.stl   binary

# Keep large binaries out of language statistics and diffs.
magnus-v1/web/static/js/jquery.js  linguist-vendored
magnus-v1/web/static/css/font-awesome-4.7.0/**  linguist-vendored
magnus-v1/web/static/js/chessboardjs-1.0.0/**   linguist-vendored
hikaru-v2/Dobot/DobotDllType.py   linguist-vendored
